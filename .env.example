# TVBox Source Aggregator 配置

# 管理后台密码（必填）
ADMIN_TOKEN=changeme

# 服务端口
PORT=5678

# 外部访问地址（Docker 部署时必填，用于 JAR 代理地址改写）
# 设为宿主机的实际 IP + 映射端口，例如：
# BASE_URL=http://192.168.1.100:5678
BASE_URL=

# 定时聚合（Cron 表达式，UTC 时区）
# 默认 UTC 5:00 = 北京时间 13:00
CRON_SCHEDULE=0 5 * * *

# 刷新接口独立 Token（可选，留空则使用 ADMIN_TOKEN）
REFRESH_TOKEN=

# 超时配置（毫秒）
SPEED_TIMEOUT_MS=5000   # 源地址延迟阈值
SITE_TIMEOUT_MS=3000    # 站点 API 测速超时
FETCH_TIMEOUT_MS=5000   # 抓取配置 JSON 超时
SPEED_TEST_CONCURRENCY=18   # 站点测速并发数（Render/CF 可下调避免卡死）
SPEED_TEST_BUDGET_MS=140000 # 单批测速总预算毫秒（约 2.3 分钟）

# 搜索源质量分级调度时区（IANA 名称，默认 Asia/Shanghai）
QUALITY_TIMEZONE=Asia/Shanghai
# 聚合整体等待上限；超时后任务继续运行，但不会重复启动下一轮
AGGREGATION_TIMEOUT_MS=420000
# Render/Node 启动聚合策略（CF Worker 不受影响）
# 有较新缓存时延迟启动聚合，避免与影视仓首批请求争抢资源
STARTUP_AGGREGATION_ENABLED=true
STARTUP_AGGREGATION_DELAY_MS=5000
STARTUP_AGGREGATION_WARM_DELAY_MS=600000
STARTUP_AGGREGATION_MAX_AGE_MS=86400000

# 数据目录（默认 ./data）
DATA_DIR=

# 可选：Render/Node 使用独立的 Cloudflare KV 作为持久化后端
# 注意：Render 的 CF_KV_NAMESPACE_ID 必须与 Cloudflare Worker 的 namespace 不同，
# 否则两个项目的设置、直播模式、测速状态会互相覆盖。
# CF_ACCOUNT_ID=
# CF_KV_NAMESPACE_ID=
# CF_API_TOKEN=
# CF_KV_TIMEOUT_MS=2500
# 仅本地运行/验证（不向 CF KV 写入，不消耗额度）。设为 off 即使用本地 SQLite。
# STORAGE_REMOTE_SYNC=off
# 等价开关：CF_KV_DISABLE=1
